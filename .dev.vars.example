# 複製成 .dev.vars(本機專用,不要上傳到任何地方),再填入值
SESSION_SECRET=換成一長串隨機字元至少32個
ADMIN_EMAILS=admin@example.com

# 本機測試用假登入:開啟後可用 http://localhost:8787/auth/dev?email=任何信箱 登入。正式環境絕對不要設。
DEV_LOGIN=1

# Google 登入(Google Cloud Console → API 與服務 → 憑證 → OAuth 用戶端 ID,類型「網頁應用程式」)
# 已授權的重新導向 URI 要加:http://localhost:8787/auth/google/callback(正式站再加上你的網域)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe(先用測試模式的金鑰 sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
